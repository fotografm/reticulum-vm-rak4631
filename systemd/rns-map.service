[Unit]
Description=ct168 RNS LoRa map (port 8085, rnsd client)
After=rnsd.service network-online.target
Requires=rnsd.service
PartOf=rnsd.service

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/rns-map
Environment=PYTHONUNBUFFERED=1
# rnsd has only the RNode, so no interface filter is needed: all is LoRa.
Environment="RNS_MAP_NODE_SUB=RNode LoRa only"
# Wait for rnsd's shared instance, else RNS would start a standalone instance.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 90); do /home/user/meshchat-venv/bin/rnstatus >/dev/null 2>&1 && exit 0; sleep 1; done; echo "rnsd shared instance not up"; exit 1'
ExecStart=/home/user/rns-map/venv/bin/python rns_map.py
Restart=always
RestartSec=15
SyslogIdentifier=rns-map

[Install]
WantedBy=multi-user.target
