# ct168-rak4631 Reticulum config — rnsd owns the RNode; MeshChat, rnstatus,
# NomadNet etc. attach to rnsd as shared-instance clients.
#
# RNode ONLY: no AutoInterface (it would reach LAN Reticulum nodes and the
# internet), no TCP interfaces.
#
# Edit from the landing page (RNSD CONFIG) or with nano, then restart rnsd.

[reticulum]
  enable_transport = Yes
  share_instance = Yes
  panic_on_interface_error = No

[logging]
  loglevel = 4

[interfaces]

  # RAK4631 WisBlock (nRF52840 + SX1262, max 22 dBm) behind an 868 MHz filter.
  # /dev/rak/rak4631 is kept current by udev on x12-4 (ct168-rak-node), so it
  # survives the board re-enumerating as a different ttyACM.
  # NL parameters, same as the Munich network.
  # 869.400-869.650 MHz sub-band: max 500 mW ERP (27 dBm) and 10 % duty
  # cycle. txpower here is before filter loss and antenna gain.
  [[RNode RAK4631]]
    type = RNodeInterface
    mode = full
    enabled = yes
    port = @RNODE_PORT@
    frequency = 869463000
    bandwidth = 125000
    spreadingfactor = 8
    codingrate = 5
    txpower = 22
    airtime_limit_long = 10
    airtime_limit_short = 33
