# MeshChat command-line options, read by meshchat.service.
# Edit from the landing page (MESHCHAT CONFIG), then Save & restart.
#
# MeshChat's own settings (display name, propagation node, announce
# interval ...) live in its database and are changed in the MeshChat web UI.
#
# Options:  --host  --port  --storage-dir  --identity-file
# The LXMF identity is <storage-dir>/identity — back it up, it is your address.
# No --reticulum-config-dir: MeshChat uses ~/.reticulum and attaches to rnsd.

MESHCHAT_ARGS="--host 0.0.0.0 --port 8000 --storage-dir /home/user/meshchat-storage"
